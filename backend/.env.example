# Source BI en lecture seule. Les anciennes clés server: / database: restent supportées.
SOURCE_DB_HOST=
SOURCE_DB_PORT=5432
SOURCE_DB_DATABASE=UPYADataDB
SOURCE_DB_USER=
SOURCE_DB_PASSWORD=
SOURCE_DB_SSLMODE=require
# verify-full + SOURCE_DB_SSL_CA_FILE pour vérifier le certificat serveur.

# Destination dédiée, distincte de UPYADataDB.
# Alternative supportée : DATABASE_URL=postgresql://...
TARGET_DB_HOST=localhost
TARGET_DB_PORT=5432
TARGET_DB_DATABASE=ukit
TARGET_DB_USER=
TARGET_DB_PASSWORD=
TARGET_DB_SSLMODE=disable

# Télémétrie optionnelle, indépendante de PostgreSQL et de l'ETL.
OBSERVE_ENABLED=false
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
